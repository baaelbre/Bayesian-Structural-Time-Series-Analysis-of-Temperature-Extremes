#!/usr/bin/env bash
#PBS -N bucex_cw_combine
#PBS -l walltime=04:00:00
#PBS -l nodes=1:ppn=1
#PBS -l mem=24gb
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"
mkdir -p logs

CHAIN_DIR="${CHAIN_DIR:-results/hpc_chains}"
FIGURE_DIR="${FIGURE_DIR:-figures/16_hpc_combined}"

exec > "logs/uccle_componentwise_combine_${PBS_JOBID}.log" 2>&1

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

echo "Combining componentwise PGAS chains"
echo "chain dir   = ${CHAIN_DIR}"
echo "figure dir  = ${FIGURE_DIR}"
date
hostname

bash examples/job_scripts/run_uccle_componentwise_combine.sh \
  "${CHAIN_DIR}" "${FIGURE_DIR}"

echo "Finished combining componentwise PGAS chains"
date
