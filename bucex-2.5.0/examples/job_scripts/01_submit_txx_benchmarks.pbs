#!/usr/bin/env bash
#PBS -N bucex250_txx_models
#PBS -l walltime=48:00:00
#PBS -l nodes=1:ppn=1
#PBS -l mem=24gb
#PBS -j oe
#PBS -t 1-20%4

set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs

TASK_ID="${PBS_ARRAYID}"
INDEX=$((TASK_ID - 1))
MODEL_INDEX=$((INDEX / 4))
CHAIN=$((INDEX % 4 + 1))
MODELS=(stationary linear_trend huerta_local_level gaetan_grigoletto_rw2 local_linear_trend)
MODEL="${MODELS[$MODEL_INDEX]}"
OUTPUT_DIR="${OUTPUT_DIR:-results/presentation}"

exec > "logs/01_txx_${MODEL}_chain_${CHAIN}_${PBS_JOBID}.log" 2>&1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

echo "model=${MODEL} chain=${CHAIN} task=${TASK_ID}"
bash examples/job_scripts/run_presentation_stage.sh run txx-benchmarks \
  --profile publication --output-dir "${OUTPUT_DIR}" \
  --benchmark "${MODEL}" --chain "${CHAIN}" --engine pgas
