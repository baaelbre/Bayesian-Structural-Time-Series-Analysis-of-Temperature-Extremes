#!/usr/bin/env bash
#PBS -N bucex250_h_screen
#PBS -l walltime=24:00:00
#PBS -l nodes=1:ppn=6
#PBS -l mem=48gb
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
OUTPUT_DIR="${OUTPUT_DIR:-results/presentation}"
exec > "logs/05_hierarchy_screen_${PBS_JOBID}.log" 2>&1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

bash examples/job_scripts/run_presentation_stage.sh run hierarchy-screen \
  --profile publication --output-dir "${OUTPUT_DIR}" \
  --pool selection --workers 6
