#!/usr/bin/env bash
#PBS -N bucex250_six_uni
#PBS -l walltime=72:00:00
#PBS -l nodes=1:ppn=1
#PBS -l mem=24gb
#PBS -j oe
#PBS -t 1-24%4

set -euo pipefail
cd "${PBS_O_WORKDIR}"
mkdir -p logs
TASK_ID="${PBS_ARRAYID}"
INDEX=$((TASK_ID - 1))
SERIES_INDEX=$((INDEX / 4))
CHAIN=$((INDEX % 4 + 1))
SERIES=(TXm TNm TXx TXn TNx TNn)
NAME="${SERIES[$SERIES_INDEX]}"
OUTPUT_DIR="${OUTPUT_DIR:-results/presentation}"
exec > "logs/04_${NAME}_chain_${CHAIN}_${PBS_JOBID}.log" 2>&1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

bash examples/job_scripts/run_presentation_stage.sh run six-univariate \
  --profile publication --output-dir "${OUTPUT_DIR}" \
  --series "${NAME}" --chain "${CHAIN}" --engine pgas
