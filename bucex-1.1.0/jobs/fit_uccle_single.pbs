#!/usr/bin/env bash
# Example: qsub -v BUCEX_SERIES=TXx,BUCEX_CHAIN_ID=1 jobs/fit_uccle_single.pbs
#PBS -N bucex_one
#PBS -l nodes=1:ppn=1
#PBS -l mem=8gb
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail

SERIES="${BUCEX_SERIES:-TXx}"
CHAIN_ID="${BUCEX_CHAIN_ID:-1}"
REPO_DIR="${BUCEX_REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
OUT_ROOT="${BUCEX_OUT_ROOT:-${REPO_DIR}/results/uccle_v1_1_${BUCEX_PRIORS:-regularized_lasso}}"
SEED="${BUCEX_SEED:-$((40 + 100 * (CHAIN_ID - 1)))}"

cd "${REPO_DIR}"
if type module >/dev/null 2>&1; then
    module purge
    module load "${BUCEX_PYTHON_MODULE:-Python}"
fi
export BUCEX_REPO_DIR="${REPO_DIR}"
export BUCEX_OUT_DIR="${OUT_ROOT}/chains/chain_${CHAIN_ID}"
export BUCEX_DATA_DIR="${BUCEX_DATA_DIR:-${REPO_DIR}/data}"

bash jobs/run_uccle_series.sh \
    "${SERIES}" "${SEED}" \
    "${BUCEX_DRAWS:-2000}" "${BUCEX_WARMUP:-2000}" "${BUCEX_THIN:-1}" \
    "${BUCEX_PRIORS:-regularized_lasso}" "${BUCEX_GEV_ENGINE:-auto}" "${BUCEX_PARTICLES:-256}"
