#!/usr/bin/env bash
#PBS -N bucex_sim_pgas
#PBS -J 1-24
#PBS -l select=1:ncpus=1:mem=12gb
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/common.sh"

SCENARIOS=(
  stationary
  linear_trend
  random_walk
  local_linear_trend
  stationary_dynamic_season
  local_linear_trend_fixed_season
)
TASK="$(array_index)"
TOTAL=$(( ${#SCENARIOS[@]} * CHAINS ))
if (( TASK > TOTAL )); then exit 0; fi
SCENARIO_INDEX=$(( (TASK - 1) / CHAINS ))
CHAIN=$(( (TASK - 1) % CHAINS + 1 ))

bucex_run simulation-fit \
  --engine pgas \
  --scenario "${SCENARIOS[$SCENARIO_INDEX]}" \
  --chain "$CHAIN" \
  --no-figures
