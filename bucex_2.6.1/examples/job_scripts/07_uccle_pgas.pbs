#!/usr/bin/env bash
#PBS -N bucex_ucc_pgas
#PBS -J 1-16
#PBS -l select=1:ncpus=1:mem=12gb
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/common.sh"

SERIES=(TXx TXn TNx TNn)
TASK="$(array_index)"
TOTAL=$(( ${#SERIES[@]} * CHAINS ))
if (( TASK > TOTAL )); then exit 0; fi
SERIES_INDEX=$(( (TASK - 1) / CHAINS ))
CHAIN=$(( (TASK - 1) % CHAINS + 1 ))

bucex_run uccle-fit \
  --engine pgas \
  --series "${SERIES[$SERIES_INDEX]}" \
  --chain "$CHAIN" \
  --no-figures

