#!/usr/bin/env bash
#
# PBS array job for the six Uccle series.
#
# Submit from the repository root:
#
#   mkdir -p logs
#   qsub jobs/fit_uccle_array.pbs
#
# Series mapping:
#   0 = TXm
#   1 = TNm
#   2 = TXx
#   3 = TXn
#   4 = TNx
#   5 = TNn
#
# Some older PBS/Torque installations use:
#
#   #PBS -t 0-5
#
# instead of:
#
#   #PBS -J 0-5
#

#PBS -N bucex_uccle
#PBS -J 0-5
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

TASK_ID="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}"

if [[ -z "${TASK_ID}" ]]; then
    echo "No PBS array index was found." >&2
    exit 2
fi

SERIES=(TXm TNm TXx TXn TNx TNn)

if (( TASK_ID < 0 || TASK_ID >= ${#SERIES[@]} )); then
    echo "Invalid PBS array index: ${TASK_ID}" >&2
    exit 2
fi

NAME="${SERIES[$TASK_ID]}"
SEED=$((40 + TASK_ID))

REPO_DIR="${BUCEX_REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
cd "${REPO_DIR}"

mkdir -p logs

SAFE_JOB_ID="${PBS_JOBID//[^[:alnum:]_.-]/_}"
LOG_FILE="logs/uccle_${SAFE_JOB_ID}_${TASK_ID}_${NAME}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

echo "============================================================"
echo "PBS job ID:       ${PBS_JOBID:-unknown}"
echo "PBS array index:  ${TASK_ID}"
echo "Series:           ${NAME}"
echo "Seed:             ${SEED}"
echo "Host:             $(hostname)"
echo "Working dir:      ${REPO_DIR}"
echo "Started:          $(date --iso-8601=seconds 2>/dev/null || date)"
echo "============================================================"

# Adapt this module name to your HPC if needed, for example:
#   export BUCEX_PYTHON_MODULE="Python/3.11.3-GCCcore-12.3.0"
if type module >/dev/null 2>&1; then
    module purge
    module load "${BUCEX_PYTHON_MODULE:-Python}"
fi

export BUCEX_REPO_DIR="${REPO_DIR}"
export BUCEX_DATA_DIR="${BUCEX_DATA_DIR:-${REPO_DIR}/data}"
export BUCEX_OUT_DIR="${BUCEX_OUT_DIR:-${REPO_DIR}/results/uccle_v02}"
export BUCEX_VENV="${BUCEX_VENV:-${REPO_DIR}/.venv}"

bash jobs/run_uccle_series.sh \
    "${NAME}" \
    "${SEED}" \
    20000 \
    5000 \
    1 \
    manuscript
