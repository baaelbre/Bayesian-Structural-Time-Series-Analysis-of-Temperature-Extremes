#!/usr/bin/env bash
#
# Quick one-chain analysis of all six Uccle series.
#
# The six fits run simultaneously on six CPU cores. After all fits finish,
# the script automatically creates the combined poster figures.
#
# The output directory is unique for every PBS job and is kept completely
# separate from the actual multi-chain results.
#
# Submit from the repository root:
#
#   mkdir -p logs
#   qsub jobs/fit_uccle_quick_all.pbs
#
# Optional overrides:
#
#   qsub -v BUCEX_N_ITER=1000,BUCEX_BURN=200 \
#       jobs/fit_uccle_quick_all.pbs
#
# These fits are for rapid plotting and inspection only, not final inference.

#PBS -N bucex_quick
#PBS -l nodes=1:ppn=6
#PBS -l mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

REPO_DIR="${BUCEX_REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
cd "${REPO_DIR}"

if type module >/dev/null 2>&1; then
    module purge
    module load "${BUCEX_PYTHON_MODULE:-Python}"
fi

VENV_DIR="${BUCEX_VENV:-${REPO_DIR}/.venv}"
if [[ -f "${VENV_DIR}/bin/activate" ]]; then
    # shellcheck disable=SC1090
    source "${VENV_DIR}/bin/activate"
fi

PYTHON="${BUCEX_PYTHON:-python}"
if ! command -v "${PYTHON}" >/dev/null 2>&1; then
    echo "Python executable '${PYTHON}' was not found." >&2
    exit 3
fi

VERSION="$(${PYTHON} -c 'import bucex; print(bucex.__version__)')"
if [[ "${VERSION}" != "0.3.3" ]]; then
    echo "Expected bucex 0.3.3, but Python imports version ${VERSION}." >&2
    echo "Run: python -m pip install -e ." >&2
    exit 3
fi

N_ITER="${BUCEX_N_ITER:-1500}"
BURN="${BUCEX_BURN:-300}"
THIN="${BUCEX_THIN:-1}"
PRIORS="${BUCEX_PRIORS:-regularized}"
SEED_BASE="${BUCEX_SEED_BASE:-940}"
MAX_STATE_TRIES="${BUCEX_MAX_STATE_TRIES:-25}"

SAFE_JOB_ID="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
SAFE_JOB_ID="${SAFE_JOB_ID//[^[:alnum:]_.-]/_}"

# A unique default output path prevents this quick run from overwriting the
# actual results or another quick run.
OUT_ROOT="${BUCEX_QUICK_OUT_ROOT:-${REPO_DIR}/results/quick/uccle_v033_${PRIORS}_${SAFE_JOB_ID}}"
ACTUAL_ROOT="${REPO_DIR}/results/uccle_v033_${PRIORS}"

if [[ "${OUT_ROOT}" == "${ACTUAL_ROOT}" ]]; then
    echo "Refusing to write quick results into the actual-results directory:" >&2
    echo "  ${ACTUAL_ROOT}" >&2
    exit 4
fi

if [[ -e "${OUT_ROOT}" ]]; then
    echo "Refusing to overwrite an existing quick-results directory:" >&2
    echo "  ${OUT_ROOT}" >&2
    exit 4
fi

mkdir -p "${OUT_ROOT}" "${REPO_DIR}/logs"

export BUCEX_REPO_DIR="${REPO_DIR}"
export BUCEX_DATA_DIR="${BUCEX_DATA_DIR:-${REPO_DIR}/data}"
export BUCEX_OUT_DIR="${OUT_ROOT}"
export BUCEX_VENV="${VENV_DIR}"
export BUCEX_CHAIN_ID=1
export BUCEX_MAX_STATE_TRIES="${MAX_STATE_TRIES}"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export MPLBACKEND=Agg
export PYTHONUNBUFFERED=1

cat > "${OUT_ROOT}/QUICK_RUN_INFO.txt" <<INFO
bucex version: ${VERSION}
PBS job ID: ${PBS_JOBID:-manual}
started: $(date --iso-8601=seconds 2>/dev/null || date)
iterations: ${N_ITER}
burn-in: ${BURN}
thinning: ${THIN}
priors: ${PRIORS}
seed base: ${SEED_BASE}
repository: ${REPO_DIR}
output: ${OUT_ROOT}

These are quick one-chain results for plotting and inspection only.
They must not be treated as final posterior inference.
INFO

echo "============================================================"
echo "BUCEX quick all-series analysis"
echo "Version:          ${VERSION}"
echo "Iterations:       ${N_ITER}"
echo "Burn-in:          ${BURN}"
echo "Priors:           ${PRIORS}"
echo "Parallel fits:    6"
echo "Output:           ${OUT_ROOT}"
echo "Host:             $(hostname)"
echo "Started:          $(date --iso-8601=seconds 2>/dev/null || date)"
echo "============================================================"

SERIES=(TXm TNm TXx TXn TNx TNn)
PIDS=()

for INDEX in "${!SERIES[@]}"; do
    NAME="${SERIES[$INDEX]}"
    SEED=$((SEED_BASE + INDEX))
    SERIES_LOG="${REPO_DIR}/logs/quick_${SAFE_JOB_ID}_${NAME}.log"

    echo "Starting ${NAME} with seed ${SEED}; log: ${SERIES_LOG}"

    (
        bash jobs/run_uccle_series.sh \
            "${NAME}" \
            "${SEED}" \
            "${N_ITER}" \
            "${BURN}" \
            "${THIN}" \
            "${PRIORS}"
    ) > "${SERIES_LOG}" 2>&1 &

    PIDS+=("$!")
done

FAILED=0

for INDEX in "${!PIDS[@]}"; do
    NAME="${SERIES[$INDEX]}"
    PID="${PIDS[$INDEX]}"

    if wait "${PID}"; then
        echo "Finished ${NAME}."
    else
        STATUS=$?
        echo "FAILED ${NAME} with exit status ${STATUS}." >&2
        FAILED=1
    fi
done

if (( FAILED != 0 )); then
    echo "At least one quick fit failed. Poster figures were not created." >&2
    echo "Inspect logs/quick_${SAFE_JOB_ID}_*.log" >&2
    exit 5
fi

FIT_COUNT=$(find "${OUT_ROOT}/fits" -maxdepth 1 -name '*_bucex_v0.3.3.pkl' -type f | wc -l)
if [[ "${FIT_COUNT}" -ne 6 ]]; then
    echo "Expected six fitted objects, but found ${FIT_COUNT}." >&2
    exit 5
fi

echo "All six fits completed. Creating poster figures..."

"${PYTHON}" examples/make_uccle_poster_figures.py \
    --fit-dir "${OUT_ROOT}/fits" \
    --out-dir "${OUT_ROOT}/poster" \
    --formats png pdf svg

cat >> "${OUT_ROOT}/QUICK_RUN_INFO.txt" <<INFO
completed: $(date --iso-8601=seconds 2>/dev/null || date)
poster directory: ${OUT_ROOT}/poster
INFO

echo "============================================================"
echo "Quick analysis complete"
echo "Fits:    ${OUT_ROOT}/fits"
echo "Figures: ${OUT_ROOT}/figures"
echo "Poster:  ${OUT_ROOT}/poster"
echo "Logs:    ${REPO_DIR}/logs/quick_${SAFE_JOB_ID}_*.log"
echo "============================================================"
