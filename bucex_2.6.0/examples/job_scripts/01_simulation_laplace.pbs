#!/usr/bin/env bash
#PBS -N bucex_sim_lap
#PBS -J 1-28
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/common.sh"

SCENARIOS=(
  stationary
  linear_trend
  local_level
  local_level_fixed_season
  local_level_dynamic_season
  stochastic_trend_fixed_season
  full_dynamic
)
TASK="$(array_index)"
TOTAL=$(( ${#SCENARIOS[@]} * CHAINS ))
if (( TASK > TOTAL )); then exit 0; fi
SCENARIO_INDEX=$(( (TASK - 1) / CHAINS ))
CHAIN=$(( (TASK - 1) % CHAINS + 1 ))

bucex_run simulation-fit \
  --engine laplace \
  --scenario "${SCENARIOS[$SCENARIO_INDEX]}" \
  --chain "$CHAIN" \
  --no-figures

