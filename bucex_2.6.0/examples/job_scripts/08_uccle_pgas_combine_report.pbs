#!/usr/bin/env bash
#PBS -N bucex_final
#PBS -l select=1:ncpus=1:mem=12gb
#PBS -l walltime=06:00:00
#PBS -j oe

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/common.sh"

bucex_combine uccle-fit --engine pgas --no-figures
bucex_report --strict --diagnostics

