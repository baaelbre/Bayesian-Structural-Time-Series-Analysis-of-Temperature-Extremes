#!/usr/bin/env bash
#PBS -N bucex_uccle_record
#PBS -l walltime=01:00:00
#PBS -l nodes=1:ppn=1
#PBS -l mem=4gb
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"
mkdir -p logs

START="${START:-1892-01-01}"
END="${END:-latest}"
DATA_DIR="${DATA_DIR:-data}"
RESULTS_ROOT="${RESULTS_ROOT:-results}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)}"
OVERWRITE="${OVERWRITE:-0}"

exec > "logs/00_uccle_record_${PBS_JOBID:-manual}.log" 2>&1

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

echo "Submitting Uccle record runner"
echo "start       = ${START}"
echo "end         = ${END}"
echo "data dir    = ${DATA_DIR}"
echo "results     = ${RESULTS_ROOT}"
echo "run id      = ${RUN_ID}"
date
hostname

bash examples/bash_scripts/run_00_uccle_record.sh \
  "${START}" "${END}" "${DATA_DIR}" "${RESULTS_ROOT}" "${RUN_ID}" "${OVERWRITE}"
