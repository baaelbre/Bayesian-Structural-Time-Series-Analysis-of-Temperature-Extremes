#!/usr/bin/env bash
#PBS -N bucex_uccle_pgas
#PBS -l walltime=96:00:00
#PBS -l nodes=1:ppn=4
#PBS -l mem=64gb
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"
mkdir -p logs

START="${START:-1892-01-01}"
END="${END:-latest}"
DRAWS="${DRAWS:-250}"
WARMUP="${WARMUP:-250}"
CHAINS="${CHAINS:-4}"
PARTICLES="${PARTICLES:-128}"
MCMC_SEED="${MCMC_SEED:-56000}"
DATA_DIR="${DATA_DIR:-data}"
RESULTS_ROOT="${RESULTS_ROOT:-results}"
RUN_ID="${RUN_ID:-$(date +%Y%m%d_%H%M%S)}"
OVERWRITE="${OVERWRITE:-0}"

exec > "logs/06_uccle_pgas_${PBS_JOBID:-manual}.log" 2>&1

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export BUCEX_MAX_PARALLEL_CHAINS="${PBS_NP:-4}"

echo "Submitting Uccle-PGAS runner"
echo "start       = ${START}"
echo "end         = ${END}"
echo "draws       = ${DRAWS}"
echo "warmup      = ${WARMUP}"
echo "chains      = ${CHAINS}"
echo "PBS cores   = ${PBS_NP:-4}"
echo "particles   = ${PARTICLES}"
echo "MCMC seed   = ${MCMC_SEED}"
echo "data dir    = ${DATA_DIR}"
echo "results     = ${RESULTS_ROOT}"
echo "run id      = ${RUN_ID}"
date
hostname

bash examples/bash_scripts/run_06_uccle_pgas.sh \
  "${START}" "${END}" "${DRAWS}" "${WARMUP}" "${CHAINS}" "${PARTICLES}" \
  "${MCMC_SEED}" "${DATA_DIR}" "${RESULTS_ROOT}" "${RUN_ID}" "${OVERWRITE}"
